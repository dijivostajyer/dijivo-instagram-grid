# cPanel production için /grid; local geliştirmede boş bırakın veya kaldırın.
NEXT_PUBLIC_BASE_PATH=/grid
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnızca mevcut server-side share/calendar entegrasyonları için; tarayıcıya asla gönderilmez.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SHARE_BUCKET=share-images
SUPABASE_SHARE_MEDIA_BUCKET=share-media
SUPABASE_WORKSPACE_MEDIA_BUCKET=workspace-media
SHARE_TTL_DAYS=30

# Instagram import sağlayıcısı yalnız server-side kullanılır. Sağlayıcı yoksa
# import endpointi sahte veri üretmeden kontrollü 503 döner.
INSTAGRAM_PROVIDER=
INSTAGRAM_PROVIDER_API_KEY=
# Bright Data Instagram Profiles dataset kimliği (yalnız server-side).
INSTAGRAM_PROFILE_DATASET_ID=

# Yedekleme (Faz 6). Yedek ZIP paketleri bu dizinde tutulur: MUTLAK yol,
# public_html DIŞINDA ve uygulama klasörünün dışında olmalı
# (ör. /home/<cpanel-kullanıcı>/grid-backups). Production'da tanımsızsa
# yedekleme devre dışı kalır; development'ta <proje>/.backups kullanılır.
BACKUP_DIR=
# cPanel Cron Job için en az 32 karakterlik rastgele secret
# (ör. `openssl rand -hex 32`). Yalnız sunucuda; tarayıcıya gönderilmez,
# loglanmaz, yedeğe girmez.
BACKUP_CRON_SECRET=


