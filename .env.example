SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SHARE_BUCKET=share-images
SUPABASE_SHARE_MEDIA_BUCKET=share-media
SHARE_TTL_DAYS=30

# --- Web push (arka plan hatırlatma) ---------------------------------------
# VAPID anahtarlarını üretin:  npx web-push generate-vapid-keys
#
# PUBLIC_KEY istemciye gider (public anahtar gizli değildir) ve push
# aboneliği açmak için kullanılır → NEXT_PUBLIC_ öneki gerekir.
# PRIVATE_KEY yalnızca Edge Function secret'ıdır:
#   supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=...
#
# ASLA yapılmayacaklar:
#   - VAPID_PRIVATE_KEY'i NEXT_PUBLIC_ ile tanımlamak
#   - VAPID_PRIVATE_KEY'i istemci kodu / bundle'a aktarmak
#   - gerçek anahtarı commit etmek
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=   # yalnızca Edge Function secrets içinde